<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Watchmen GY6</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Watchmen only uses standard HTTPS / TLS via Apple's WebKit + URL
	     loading system. That qualifies for the U.S. export-compliance
	     encryption exemption, so we declare "non-exempt encryption: NO"
	     to skip the prompt on every TestFlight + App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- v1.0: full media permission set. iOS WKWebView's file-input action
	     sheet ALWAYS includes "Take Photo or Video" regardless of accept
	     attribute or Info.plist content. The only way to avoid a hard
	     __abort_with_payload crash when the user taps that option is to
	     declare NSCameraUsageDescription and NSMicrophoneUsageDescription
	     (iOS terminates the app on camera access without these keys).
	     Hiding the option entirely would require a custom Capacitor plugin
	     or AppDelegate UIDocumentPickerViewController interception, both
	     of which were attempted in 1.0(4) and 1.0(5) but failed Swift
	     Package Manager resolution. Restoring these keys is the
	     crash-free path for App Store approval.
	     NSPhotoLibraryUsageDescription is required for legacy library
	     access; NSPhotoLibraryAddUsageDescription is used by the
	     digital-member-card "Save to Photos" action;
	     NSCameraUsageDescription gates the camera path in the file input;
	     NSMicrophoneUsageDescription gates audio capture when recording
	     video through the camera path. -->
	<key>NSCameraUsageDescription</key>
	<string>Watchmen accesses your camera only when you tap "Take Photo or Video" in the upload picker to capture a new photo or short video to share with the brotherhood. No background camera access.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Watchmen accesses your microphone only when you choose to record a video in the upload picker so the video can include sound. No background microphone access.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Watchmen reads photos from your library when you choose to attach one to a post, message, group banner, or your profile photo. Only the photos you explicitly select are shared.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Watchmen needs permission to save your member card image to Photos when you tap the share or save action.</string>

	<!-- Location is requested only when a brother taps "Check in" at a
	     meet-up or event to verify they're at the venue. We never track
	     location in the background. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Watchmen uses your location only when you tap "Check in" at a meet-up or event to confirm you're at the venue. Location is not tracked in the background.</string>
</dict>
</plist>
