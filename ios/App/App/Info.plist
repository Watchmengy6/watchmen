<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Watchmen GY6</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Watchmen only uses standard HTTPS / TLS via Apple's WebKit + URL
	     loading system. That qualifies for the U.S. export-compliance
	     encryption exemption, so we declare "non-exempt encryption: NO"
	     to skip the prompt on every TestFlight + App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Required by iOS for any app that touches the camera or photo
	     library. Even if the user never grants permission, iOS hard-
	     crashes the app on first request if these keys are missing.
	     Apple Review (June 9 2026) rejected the app because tapping
	     the photo upload control on iPad crashed before the permission
	     prompt could appear. These strings are surfaced to the user in
	     the iOS permission dialog. -->
	<key>NSCameraUsageDescription</key>
	<string>Watchmen uses your camera so you can take a photo or video to share with the brotherhood — for example, posting an update on the feed, attaching a photo to a message, or capturing a profile picture.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Watchmen reads photos from your library when you choose to attach one to a post, message, group banner, or your profile photo. Only the photos you explicitly select are shared.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Watchmen needs permission to save your member card image to Photos when you tap the share or save action.</string>

	<!-- The feed composer + message composer accept video/* uploads. When
	     the user picks a video via the iOS camera/photo picker, iOS may
	     require microphone permission too (since recorded video captures
	     audio). Adding this string up front avoids a hard crash when a
	     brother taps "record video" in the picker. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Watchmen needs microphone access only if you choose to record a video in the app so the recording can include audio. Existing videos and photos from your library do not use the microphone.</string>

	<!-- Location is requested only when a brother taps "Check in" at a
	     meet-up or event to verify they're at the venue. We never track
	     location in the background. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Watchmen uses your location only when you tap "Check in" at a meet-up or event to confirm you're at the venue. Location is not tracked in the background.</string>
</dict>
</plist>
