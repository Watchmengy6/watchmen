# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from https://app.supabase.com → your project → Settings → API.

# Public — exposed to the browser. Safe.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — NEVER expose. Used for admin actions (approvals, role changes,
# awarding points server-side). Do not commit. Vercel: add as encrypted env var.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL — used for building invite links.
# Local: http://localhost:3000 | Prod: https://thewatchman.app (or your domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
